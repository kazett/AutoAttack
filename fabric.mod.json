{
  "schemaVersion": 1,
  "id": "autoattack",
  "version": "${mod_version}",
  "name": "Auto Attack",
  "description": "Auto Attack makes it so that holding the attack button autoswings the sword, similar to the combat snapshots.",
  "authors": [
    "Kazet"
  ],
  "contributors": [
    "Tfarecnim",
    "BlazingTwist",
    "Rongmario"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/autoattack",
    "sources": "https://github.com/kazet/AutoAttack",
    "issues": "https://github.com/kazet/AutoAttack/issues"
  },
  "license": "MIT",
  "icon": "assets/autoattack/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "autoattack.Main"
    ],
    "client": [
      "autoattack.AutoAttack",
      "autoattack.KeyBindingConfig"
    ]
  },
  "mixins": [
    "autoattack.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.22",
    "fabric-api": "*",
    "midnightlib": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}