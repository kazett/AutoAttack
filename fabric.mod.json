{
  "schemaVersion": 1,
  "id": "autoattack",
  "version": "${version}",
  "name": "Auto Attack",
  "description": "Auto Attack makes it so that holding the attack button autoswings the sword, similar to the combat snapshots.",
  "authors": [
    "Kazet"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/autoattack/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "autoattack.Main"
    ],
    "client": [
      "autoattack.AutoAttack",
      "autoattack.KeyBindingConfig"
    ]
  },
  "mixins": [
    "autoattack.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "midnightlib": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
